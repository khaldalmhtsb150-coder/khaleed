# ===== Discord =====
DISCORD_TOKEN=ضع_توكن_البوت_هنا
CLIENT_ID=آيدي_التطبيق
CLIENT_SECRET=سيكرت_OAuth2_من_بوابة_المطورين

# مالكو البوت (آيديات مفصولة بفاصلة)
OWNER_IDS=1392792427051614249,1229657759717523487

# ===== Dashboard =====
# رابط اللوحة العام — بدون / في النهاية
# مثال bot-hosting: https://xxxx.apps.bot-hosting.cloud
DASHBOARD_URL=https://xxxx.apps.bot-hosting.cloud
# لا تضع PORT على الاستضافة: المنفذ يؤخذ تلقائياً من SERVER_PORT

# رابط سيرفر الدعم (اختياري) — يظهر بالصفحة الرئيسية للموقع
# SUPPORT_URL=https://discord.gg/xxxx

# AI assistant + staff applications (optional). A free Gemini key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
# Backup provider used when the main one is busy (free key: https://console.groq.com/keys)
# GROQ_API_KEY=
# AI_MODEL=
# AI_DAILY_FREE=60
# AI_DAILY_PREMIUM=800
# AI_DAILY_GLOBAL=3000

# ===== Growth =====
# Channel (in your support server) where the weekly Marka Cup results are posted
# TOURNEY_CHANNEL_ID=
# Referral reward and the minimum members of a new server
# REF_DAYS=7
# REF_MIN_MEMBERS=50
# Hide the "Add Marka" button everywhere
# BRAND_BUTTON=0
